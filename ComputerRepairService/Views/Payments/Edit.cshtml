@model ComputerRepairService.Models.Entities.Payment

@{
    ViewData["Title"] = "Редактировать платеж";
    Layout = "_Layout";
    var serviceOrders = ViewBag.ServiceOrders as List<ComputerRepairService.Models.Entities.ServiceOrder>;
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-warning bg-gradient text-dark rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Редактирование платежа #@Model.PaymentId</h2>
                <div class="text-muted small">Корректировка данных транзакции</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="PaymentId" />
                        <input type="hidden" asp-for="PaymentDate" />
                        <input type="hidden" asp-for="OrderId" />

                        <div class="bg-light p-4 rounded-4 mb-4">
                            <h6 class="fw-bold mb-3 text-secondary text-uppercase" style="letter-spacing: 0.5px;">Привязка заказа</h6>
                            <div class="form-floating mb-0">
                                <select class="form-select rounded-3" disabled>
                                    @if (serviceOrders != null)
                                    {
                                        var order = serviceOrders.FirstOrDefault(o => o.OrderId == Model.OrderId);
                                        if (order != null)
                                        {
                                            <option selected>Заказ #@order.OrderId - @order.Customer?.FirstName @order.Customer?.LastName (@order.TotalCost.ToString("C0"))</option>
                                        }
                                        else
                                        {
                                            <option selected>Заказ #@Model.OrderId</option>
                                        }
                                    }
                                    else
                                    {
                                        <option selected>Заказ #@Model.OrderId</option>
                                    }
                                </select>
                                <label>Привязанный заказ</label>
                            </div>
                            <small class="text-muted mt-2 d-block"><i class="fas fa-lock me-1 text-secondary"></i> Заказ нельзя изменить после проведения платежа.</small>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Amount" class="form-control rounded-3 border-success fs-5 fw-bold" type="number" step="0.01" min="0" placeholder="Сумма" />
                                    <label asp-for="Amount">Сумма (₽)</label>
                                    <span asp-validation-for="Amount" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Status" class="form-select rounded-3 border-warning">
                                        <option value="Completed">Завершен</option>
                                        <option value="Pending">Ожидание</option>
                                        <option value="Failed">Ошибка</option>
                                        <option value="Refunded">Возврат</option>
                                    </select>
                                    <label asp-for="Status">Статус платежа</label>
                                    <span asp-validation-for="Status" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="PaymentMethod" class="form-select rounded-3">
                                        <option value="Cash">Наличные</option>
                                        <option value="Card">Банковская карта</option>
                                        <option value="Bank Transfer">Банковский перевод</option>
                                        <option value="Online">Онлайн-оплата</option>
                                    </select>
                                    <label asp-for="PaymentMethod">Способ оплаты</label>
                                    <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="TransactionId" class="form-control rounded-3" placeholder="ID Транзакции" />
                                    <label asp-for="TransactionId">ID транзакции</label>
                                    <span asp-validation-for="TransactionId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Notes" class="form-control rounded-3" style="height: 100px" placeholder="Комментарий"></textarea>
                            <label asp-for="Notes">Комментарий к платежу</label>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-warning rounded-pill px-5 fw-bold text-dark shadow-sm">
                                <i class="fas fa-save me-2"></i> Обновить платеж
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 text-dark"><i class="fas fa-info-circle text-info me-2"></i> Сводка</h5>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-muted fw-medium">ID Транзакции:</span>
                            <span class="fw-bold text-dark">#@Model.PaymentId</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-muted fw-medium">Дата создания:</span>
                            <span class="fw-bold text-dark">@Model.PaymentDate.ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom pb-2">
                            <span class="text-muted fw-medium">Сумма чека:</span>
                            <span class="fw-bold text-success">@Model.Amount.ToString("C0")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
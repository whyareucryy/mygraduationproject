@model IEnumerable<ComputerRepairService.Models.Entities.Payment>
@using ComputerRepairService.Services

@{
    ViewData["Title"] = "Управление платежами";
    Layout = "_Layout";
    var statusFilter = ViewBag.StatusFilter as string ?? string.Empty;
    var ordersAwaiting = ViewBag.OrdersAwaitingPayment as List<ComputerRepairService.Models.Entities.ServiceOrder> ?? new();

    var activePayments = Model.Where(p => p.Status == "Pending" || p.Status == "Failed").ToList();
    var completedPayments = Model.Where(p => p.Status == "Completed" || p.Status == "Refunded").ToList();
}

<div class="container-fluid mt-4">
    <!-- Заголовок и фильтры -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-success bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Платежи</h2>
                <div class="text-muted small">Управление транзакциями и оплатой заказов</div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-3 d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success fs-4 me-3"></i> 
            <div class="fw-medium text-success">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-3 d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle text-danger fs-4 me-3"></i> 
            <div class="fw-medium text-danger">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Статистика -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="text-success bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-check-double fs-5"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@Model.Count(p => p.Status == "Completed")</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Завершенные</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="text-warning bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-hourglass-half fs-5"></i>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1"><i class="fas fa-exclamation-circle me-1"></i>Ожидают: @ordersAwaiting.Count</span>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@Model.Count(p => p.Status == "Pending")</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">В обработке</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="text-danger bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-times-circle fs-5"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@Model.Count(p => p.Status == "Failed")</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Ошибки оплаты</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-success bg-gradient text-white">
                <div class="card-body p-4 position-relative">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="fas fa-chart-line fa-4x text-white"></i>
                    </div>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px;">
                            <i class="fas fa-ruble-sign fs-5 text-white"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1">@Model.Where(p => p.Status == "Completed").Sum(p => p.Amount).ToString("C0")</h2>
                    <p class="text-white-50 mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Общая сумма</p>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4 border-bottom-0 gap-2" id="paymentsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-medium" id="active-tab" data-bs-toggle="tab" data-bs-target="#active-payments" type="button" role="tab" aria-controls="active-payments" aria-selected="true">
                <i class="fas fa-clock me-2"></i>Актуальные
                @if (ordersAwaiting.Any() || activePayments.Any())
                {
                    <span class="badge bg-danger rounded-pill ms-2">@(ordersAwaiting.Count + activePayments.Count)</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-medium" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-payments" type="button" role="tab" aria-controls="history-payments" aria-selected="false">
                <i class="fas fa-history me-2"></i>История платежей
                <span class="badge bg-secondary rounded-pill ms-2">@completedPayments.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="paymentsTabsContent">
        
        <!-- Вкладка: Актуальные -->
        <div class="tab-pane fade show active" id="active-payments" role="tabpanel" aria-labelledby="active-tab">
            <div class="row g-4">
                <!-- Заказы ожидающие оплаты -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-hourglass-half text-warning me-2"></i> Заказы в ожидании оплаты</h5>
                        </div>
                        <div class="card-body p-0">
                            @if (!ordersAwaiting.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                        <i class="fas fa-check-circle fa-2x text-success opacity-75"></i>
                                    </div>
                                    <h6 class="fw-bold text-dark">Все заказы оплачены</h6>
                                    <p class="small mb-0">Нет заказов, требующих оплаты в данный момент.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 data-table w-100">
                                        <thead class="table-light text-muted small text-uppercase">
                                            <tr>
                                            <th class="ps-4 py-3 border-0">Заказ</th>
                                            <th class="py-3 border-0">Клиент</th>
                                            <th class="py-3 border-0">К оплате</th>
                                            <th class="pe-4 py-3 border-0 text-end">Действия</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in ordersAwaiting)
                                            {
                                                var due = OrderPaymentHelper.GetAmountDue(order);
                                                <tr>
                                                    <td class="ps-4 py-3 border-bottom-0" data-order="@order.OrderId">
                                                        <div class="fw-bold text-dark">Заказ #@order.OrderId</div>
                                                        <div class="small text-muted">@order.DeviceBrand @order.DeviceModel</div>
                                                    </td>
                                                    <td class="py-3 border-bottom-0" data-order="@order.Customer?.FirstName @order.Customer?.LastName">
                                                        <div class="fw-medium text-dark">@order.Customer?.FirstName @order.Customer?.LastName</div>
                                                    </td>
                                                    <td class="py-3 border-bottom-0" data-order="@due">
                                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-50 rounded-pill px-3 py-2 fs-6 fw-bold">
                                                            @due.ToString("C0")
                                                        </span>
                                                    </td>
                                                    <td class="pe-4 py-3 border-bottom-0 text-end">
                                                        <div class="d-flex justify-content-end gap-2">
                                                            <form asp-action="ConfirmPayment" method="post" class="m-0">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                                                <input type="hidden" name="paymentMethod" value="Cash" />
                                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill fw-medium px-3" title="Быстрая оплата наличными">
                                                                    <i class="fas fa-money-bill-wave me-1"></i> Наличные
                                                                </button>
                                                            </form>
                                                            <a asp-controller="ServiceOrders" asp-action="IssueOrder" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary rounded-pill fw-medium px-3 shadow-sm">
                                                                <i class="fas fa-cash-register me-1"></i> Оформить выдачу
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Платежи в обработке / Ошибки -->
                @if (activePayments.Any())
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-sync-alt text-primary me-2"></i> Платежи в обработке и ошибки</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 data-table w-100">
                                        <thead class="table-light text-muted small text-uppercase">
                                            <tr>
                                            <th class="ps-4 py-3 border-0">ID Платежа</th>
                                            <th class="py-3 border-0">Заказ</th>
                                            <th class="py-3 border-0">Сумма</th>
                                            <th class="py-3 border-0">Статус</th>
                                            <th class="pe-4 py-3 border-0 text-end">Действия</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in activePayments)
                                            {
                                                <tr>
                                                    <td class="ps-4 py-3 border-bottom-0 fw-medium" data-order="@item.PaymentId">#@item.PaymentId</td>
                                                    <td class="py-3 border-bottom-0" data-order="@item.OrderId">
                                                        <a asp-controller="ServiceOrders" asp-action="Details" asp-route-id="@item.OrderId" class="text-decoration-none fw-medium text-primary">
                                                            Заказ #@item.OrderId
                                                        </a>
                                                    </td>
                                                    <td class="py-3 border-bottom-0 fw-bold text-dark" data-order="@item.Amount">@item.Amount.ToString("C")</td>
                                                    <td class="py-3 border-bottom-0" data-order="@item.Status">
                                                        @if (item.Status == "Pending")
                                                        {
                                                            <span class="badge bg-warning text-dark rounded-pill">Ожидание</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger rounded-pill">Ошибка</span>
                                                        }
                                                    </td>
                                                    <td class="pe-4 py-3 border-bottom-0 text-end">
                                                        <div class="btn-group shadow-sm rounded-pill">
                                                            <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-light btn-sm text-info px-3" title="Подробнее">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                                                            {
                                                                <a asp-action="Edit" asp-route-id="@item.PaymentId" class="btn btn-light btn-sm text-warning px-3 border-start" title="Редактировать">
                                                                    <i class="fas fa-edit"></i>
                                                                </a>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Вкладка: Завершенные (История) -->
        <div class="tab-pane fade" id="history-payments" role="tabpanel" aria-labelledby="history-tab">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history text-secondary me-2"></i> История платежей</h5>
                </div>
                <div class="card-body p-4">
                    @if (!completedPayments.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="fas fa-receipt fa-2x text-muted opacity-50"></i>
                            </div>
                            <h6 class="fw-bold text-dark">История пуста</h6>
                            <p class="small mb-0">Завершенных платежей пока нет.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 data-table w-100">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                            <th class="ps-4 py-3 border-0">Дата / ID</th>
                                            <th class="py-3 border-0">Заказ</th>
                                            <th class="py-3 border-0">Клиент</th>
                                            <th class="py-3 border-0">Метод</th>
                                            <th class="py-3 border-0">Сумма</th>
                                            <th class="py-3 border-0">Статус</th>
                                            <th class="pe-4 py-3 border-0 text-end">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in completedPayments)
                                    {
                                        <tr>
                                            <td class="ps-4 py-3 border-bottom-0" data-order="@item.PaymentDate.Ticks">
                                                <div class="fw-medium text-dark mb-1">@item.PaymentDate.ToString("dd.MM.yyyy HH:mm")</div>
                                                <div class="small text-muted">Транзакция #@item.PaymentId</div>
                                            </td>
                                            <td class="py-3 border-bottom-0" data-order="@item.OrderId">
                                                <a asp-controller="ServiceOrders" asp-action="Details" asp-route-id="@item.OrderId" class="text-decoration-none fw-medium text-primary">
                                                    Заказ #@item.OrderId
                                                </a>
                                            </td>
                                            <td class="py-3 border-bottom-0" data-order="@item.ServiceOrder?.Customer?.FirstName @item.ServiceOrder?.Customer?.LastName">
                                                <div class="fw-medium text-dark">@item.ServiceOrder?.Customer?.FirstName @item.ServiceOrder?.Customer?.LastName</div>
                                            </td>
                                            <td class="py-3 border-bottom-0" data-order="@item.PaymentMethod">
                                                @switch (item.PaymentMethod)
                                                {
                                                    case "Cash":
                                                        <span class="badge bg-light text-dark border rounded-pill"><i class="fas fa-money-bill text-success me-1"></i> Наличные</span>
                                                        break;
                                                    case "Card":
                                                        <span class="badge bg-light text-dark border rounded-pill"><i class="fas fa-credit-card text-primary me-1"></i> Карта</span>
                                                        break;
                                                    case "Bank Transfer":
                                                        <span class="badge bg-light text-dark border rounded-pill"><i class="fas fa-university text-info me-1"></i> Перевод</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-light text-dark border rounded-pill">@item.PaymentMethod</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="py-3 border-bottom-0 fw-bold text-dark" data-order="@item.Amount">@item.Amount.ToString("C")</td>
                                            <td class="py-3 border-bottom-0" data-order="@item.Status">
                                                @if (item.Status == "Completed")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1"><i class="fas fa-check me-1"></i>Завершен</span>
                                                }
                                                else if (item.Status == "Refunded")
                                                {
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2 py-1"><i class="fas fa-undo me-1"></i>Возврат</span>
                                                }
                                            </td>
                                            <td class="pe-4 py-3 border-bottom-0 text-end">
                                                <div class="btn-group shadow-sm rounded-pill">
                                                    <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-light btn-sm text-info px-3" title="Подробнее">
                                                        <i class="fas fa-file-invoice"></i>
                                                    </a>
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-action="Delete" asp-route-id="@item.PaymentId" class="btn btn-light btn-sm text-danger px-3 border-start" title="Удалить">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <style>
        .rounded-4 { border-radius: 1rem !important; }
        .table > :not(caption) > * > * { padding: 1rem 0.5rem; background-color: transparent; }
        tbody tr:hover { background-color: rgba(0,0,0,.015) !important; }
    </style>
}

@section Scripts {
}
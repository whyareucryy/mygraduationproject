@model ComputerRepairService.Models.Entities.Payment

@{
    ViewData["Title"] = "Подробности о платеже";
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-dark bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-file-invoice"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Чек #@Model.PaymentId</h2>
                <div class="text-muted small">
                    От @Model.PaymentDate.ToString("dd.MM.yyyy HH:mm") • 
                    @switch (Model.Status)
                    {
                        case "Completed": <span class="badge bg-success ms-1">Завершен</span> break;
                        case "Pending": <span class="badge bg-warning text-dark ms-1">Ожидание</span> break;
                        case "Failed": <span class="badge bg-danger ms-1">Ошибка</span> break;
                        case "Refunded": <span class="badge bg-info ms-1">Возврат</span> break;
                        default: <span class="badge bg-secondary ms-1">@Model.Status</span> break;
                    }
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
            {
                <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-warning rounded-pill px-4 shadow-sm fw-medium">
                    <i class="fas fa-edit me-2"></i>Редактировать
                </a>
            }
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-5 pb-3 border-bottom">
                        <div class="text-muted mb-2 text-uppercase fw-bold" style="letter-spacing: 1px;">Сумма платежа</div>
                        <h1 class="display-3 fw-bold text-dark mb-0">@Model.Amount.ToString("C")</h1>
                    </div>

                    <div class="row g-4">
                        <div class="col-sm-6">
                            <h6 class="text-muted small mb-1">Связанный заказ</h6>
                            @if (Model.ServiceOrder != null)
                            {
                                <a asp-controller="ServiceOrders" asp-action="Details" asp-route-id="@Model.OrderId" class="fw-bold fs-5 text-primary text-decoration-none">
                                    <i class="fas fa-external-link-alt small me-1"></i> Заказ #@Model.OrderId
                                </a>
                            }
                            else
                            {
                                <div class="fw-bold fs-5 text-dark">Заказ #@Model.OrderId</div>
                            }
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-muted small mb-1">Плательщик (Клиент)</h6>
                            <div class="fw-bold fs-5 text-dark">
                                @if (Model.ServiceOrder?.Customer != null)
                                {
                                    @($"{Model.ServiceOrder.Customer.FirstName} {Model.ServiceOrder.Customer.LastName}")
                                }
                                else
                                {
                                    <span class="text-muted">Неизвестно</span>
                                }
                            </div>
                        </div>
                        
                        <div class="col-sm-6">
                            <h6 class="text-muted small mb-1">Метод оплаты</h6>
                            <div class="fw-bold fs-5 text-dark">
                                @switch (Model.PaymentMethod)
                                {
                                    case "Cash": <span><i class="fas fa-money-bill text-success me-2"></i>Наличные</span> break;
                                    case "Card": <span><i class="fas fa-credit-card text-primary me-2"></i>Карта</span> break;
                                    case "Bank Transfer": <span><i class="fas fa-university text-info me-2"></i>Перевод</span> break;
                                    case "Online": <span><i class="fas fa-globe text-dark me-2"></i>Онлайн</span> break;
                                    default: <span>@Model.PaymentMethod</span> break;
                                }
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-muted small mb-1">ID Транзакции системы</h6>
                            <div class="fw-bold fs-5 text-dark font-monospace">@(Model.TransactionId ?? "—")</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-4 pt-4 border-top">
                            <h6 class="text-muted small mb-2">Примечания / Комментарий</h6>
                            <div class="p-3 bg-light rounded-3">@Model.Notes</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-cog text-secondary me-2"></i>Быстрые действия</h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <a asp-action="Create" class="btn btn-primary rounded-pill w-100 py-2 shadow-sm">
                            <i class="fas fa-plus me-2"></i>Новый платеж
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@Model.PaymentId" class="btn btn-outline-danger rounded-pill w-100 py-2 border-2">
                                <i class="fas fa-trash me-2"></i>Удалить чек
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
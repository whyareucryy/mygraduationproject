@model ComputerRepairService.Models.Entities.ServiceOrder

@{
    ViewData["Title"] = "Детали заказа";
    var canManageParts = ViewBag.CanManageParts as bool? ?? false;
    var partsTotal = ViewBag.PartsTotal as decimal? ?? Model.OrderParts.Sum(p => p.TotalPrice);
    var availableParts = ViewBag.AvailableParts as IEnumerable<ComputerRepairService.Models.ViewModels.AvailablePartOption>
        ?? Enumerable.Empty<ComputerRepairService.Models.ViewModels.AvailablePartOption>();
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Заказ #@Model.OrderId</h2>
                <div class="text-muted small">
                    От @Model.CreatedDate.ToString("dd.MM.yyyy") • 
                    <span class="badge bg-secondary ms-1">@Model.OrderStatus?.StatusName</span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap justify-content-md-end">
            @if (ComputerRepairService.Services.OrderPaymentHelper.CanEmployeeComplete(Model) || Model.StatusId == ComputerRepairService.Models.Enums.OrderStatusIds.New)
            {
                <button type="button" class="btn btn-warning rounded-pill shadow-sm fw-medium px-3" data-bs-toggle="modal" data-bs-target="#requireApprovalModal">
                    <i class="fas fa-hand-holding-usd me-1"></i> На согласование
                </button>
            }
            
            @if (ComputerRepairService.Services.OrderPaymentHelper.CanEmployeeComplete(Model))
            {
                <a asp-action="CompleteOrder" asp-route-id="@Model.OrderId" class="btn btn-success rounded-pill shadow-sm fw-medium px-3">
                    <i class="fas fa-check-circle me-1"></i> Завершить ремонт
                </a>
            }
            
            @if (ComputerRepairService.Services.OrderPaymentHelper.CanIssueDevice(Model))
            {
                <a asp-action="IssueOrder" asp-route-id="@Model.OrderId" class="btn btn-primary rounded-pill shadow-sm fw-medium px-3">
                    <i class="fas fa-box-open me-1"></i> Выдать
                </a>
            }

            <div class="dropdown">
                <button class="btn btn-light rounded-pill shadow-sm border px-3 dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-ellipsis-v me-1"></i> Опции
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="dropdownMenuButton">
                    <li><a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@Model.OrderId"><i class="fas fa-edit text-warning me-2"></i> Редактировать</a></li>
                    <li><a class="dropdown-item py-2" asp-action="ChangeStatus" asp-route-id="@Model.OrderId"><i class="fas fa-sync-alt text-info me-2"></i> Изменить статус</a></li>
                </ul>
            </div>

            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Основная информация -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-info-circle text-primary me-2"></i> Общая информация</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-user"></i></div>
                                <div>
                                    <div class="text-muted small">Клиент</div>
                                    <div class="fw-bold">@Model.Customer?.FirstName @Model.Customer?.LastName</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-phone"></i></div>
                                <div>
                                    <div class="text-muted small">Телефон</div>
                                    <div class="fw-bold">@Model.Customer?.Phone</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-envelope"></i></div>
                                <div>
                                    <div class="text-muted small">Email</div>
                                    <div class="fw-bold">@(Model.Customer?.Email ?? "—")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-laptop"></i></div>
                                <div>
                                    <div class="text-muted small">Устройство</div>
                                    <div class="fw-bold">@Model.DeviceBrand @Model.DeviceModel (@Model.DeviceType?.TypeName)</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-barcode"></i></div>
                                <div>
                                    <div class="text-muted small">S/N</div>
                                    <div class="fw-bold">@(Model.SerialNumber ?? "—")</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-exclamation-circle"></i></div>
                                <div>
                                    <div class="text-muted small">Приоритет</div>
                                    @{
                                        var priorityText = Model.Priority switch
                                        {
                                            1 => "Низкий", 2 => "Средний", 3 => "Высокий", 4 => "Срочный", 5 => "Критичный", _ => "Неизвестно"
                                        };
                                        var badgeColor = Model.Priority >= 4 ? "danger" : (Model.Priority == 3 ? "warning text-dark" : "info");
                                    }
                                    <span class="badge bg-@badgeColor">@priorityText</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Предполагаемое завершение</div>
                                <div class="fw-bold fs-5">
                                    @if (Model.EstimatedCompletionDate.HasValue)
                                    {
                                        @Model.EstimatedCompletionDate.Value.ToString("dd.MM.yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-6">Не указано</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <div class="text-muted small mb-1">Фактическое завершение</div>
                                <div class="fw-bold fs-5">
                                    @if (Model.ActualCompletionDate.HasValue)
                                    {
                                        @Model.ActualCompletionDate.Value.ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-6">В работе</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-dark"><i class="fas fa-comment-dots text-secondary me-2"></i>Описание проблемы</h6>
                        <div class="p-3 bg-light rounded-3 border-start border-4 border-danger">
                            @Model.ProblemDescription
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DiagnosticNotes))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark"><i class="fas fa-stethoscope text-info me-2"></i>Диагностика</h6>
                            <div class="p-3 bg-info bg-opacity-10 rounded-3 border-start border-4 border-info">
                                @Model.DiagnosticNotes
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
                    {
                        <div class="mb-0">
                            <h6 class="fw-bold text-dark"><i class="fas fa-tools text-warning me-2"></i>Заметки мастера</h6>
                            <div class="p-3 bg-warning bg-opacity-10 rounded-3 border-start border-4 border-warning">
                                @Model.TechnicianNotes
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Запчасти -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" id="order-parts">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-microchip text-info me-2"></i> Использованные запчасти</h5>
                    @if (canManageParts)
                    {
                        <button type="button" class="btn btn-info btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addPartModal">
                            <i class="fas fa-plus me-1"></i> Списать со склада
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.OrderParts != null && Model.OrderParts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Запчасть</th>
                                        <th>Кол-во</th>
                                        <th>Цена</th>
                                        <th>Сумма</th>
                                        <th>Дата</th>
                                        @if (canManageParts) { <th class="pe-4 text-end">Действия</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var part in Model.OrderParts.OrderByDescending(p => p.UsageDate))
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-medium">@part.Inventory?.PartName</div>
                                                <small class="text-muted">ID #@part.PartId</small>
                                            </td>
                                            <td>@part.QuantityUsed шт.</td>
                                            <td>@part.UnitPriceAtTime.ToString("C0")</td>
                                            <td class="fw-bold text-success">@part.TotalPrice.ToString("C0")</td>
                                            <td class="text-muted small">@part.UsageDate.ToString("dd.MM.yy HH:mm")</td>
                                            @if (canManageParts)
                                            {
                                                <td class="pe-4 text-end">
                                                    <form asp-action="RemoveOrderPart" method="post" class="d-inline"
                                                          onsubmit="return confirm('Вернуть @part.QuantityUsed шт. «@part.Inventory?.PartName» на склад?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="orderPartId" value="@part.OrderPartId" />
                                                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" title="Вернуть на склад">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td class="ps-4 fw-bold text-muted text-uppercase small" colspan="3">Итого запчасти</td>
                                        <td class="fw-bold">@partsTotal.ToString("C0")</td>
                                        <td colspan="@(canManageParts ? 2 : 1)"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-box-open fa-2x mb-2 opacity-50"></i>
                            <p class="mb-0 small">
                                @if (canManageParts)
                                {
                                    <span>Запчасти ещё не списаны. Нажмите «Списать со склада», когда начнёте ремонт.</span>
                                }
                                else
                                {
                                    <span>Запчасти по этому заказу не использовались.</span>
                                }
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Боковая панель -->
        <div class="col-lg-4">
            <!-- Стоимость -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-success bg-gradient text-white position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fas fa-wallet fa-4x"></i>
                </div>
                <div class="card-body p-4 position-relative">
                    <h6 class="fw-bold mb-3 opacity-75 text-uppercase" style="letter-spacing: 1px;">Итоговая стоимость</h6>
                    <h1 class="display-5 fw-bold mb-2">@Model.TotalCost.ToString("C0")</h1>
                    @if (partsTotal > 0)
                    {
                        <div class="small opacity-90">
                            <div class="d-flex justify-content-between"><span>Запчасти:</span><span>@partsTotal.ToString("C0")</span></div>
                            @{
                                var laborPart = Math.Max(0, Model.TotalCost - partsTotal);
                            }
                            @if (laborPart > 0 || Model.TotalCost > partsTotal)
                            {
                                <div class="d-flex justify-content-between"><span>Работы:</span><span>@laborPart.ToString("C0")</span></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Мастера -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-users-cog text-secondary me-2"></i>Мастера</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.OrderTechnicians.Any())
                    {
                        <ul class="list-group list-group-flush rounded-bottom-4">
                            @foreach (var orderTech in Model.OrderTechnicians)
                            {
                                <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center border-0 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
                                            <i class="fas fa-user-tie"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@orderTech.Technician?.FirstName @orderTech.Technician?.LastName</div>
                                            <div class="text-muted small">С @orderTech.AssignedDate.ToString("dd.MM.yy")</div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-user-slash fa-2x mb-2 opacity-50"></i>
                            <p class="mb-0 small">Мастера еще не назначены</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Модальное окно для "На согласование" -->
    <div class="modal fade" id="requireApprovalModal" tabindex="-1" aria-labelledby="requireApprovalModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="RequireApproval" asp-route-id="@Model.OrderId" method="post" class="modal-content border-0 shadow rounded-4">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning bg-opacity-10 border-warning border-opacity-25 py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark" id="requireApprovalModalLabel"><i class="fas fa-hand-holding-usd text-warning me-2"></i> Запросить согласование</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-4">Клиенту будет отправлено уведомление для подтверждения стоимости ремонта.</p>
                    @if (partsTotal > 0)
                    {
                        <div class="alert alert-light border rounded-3 small mb-3">
                            <i class="fas fa-microchip text-info me-1"></i>
                            Уже списано запчастей на <strong>@partsTotal.ToString("C0")</strong> — учтите это в смете для клиента.
                        </div>
                    }
                    <div class="form-floating mb-3">
                        <input type="number" class="form-control rounded-3" id="estimatedCost" name="estimatedCost" min="0" step="0.01" required placeholder="Стоимость" value="@(partsTotal > 0 ? partsTotal.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")">
                        <label for="estimatedCost">Предварительная стоимость (₽) <span class="text-danger">*</span></label>
                    </div>
                    <div class="form-floating mb-0">
                        <textarea class="form-control rounded-3" id="notes" name="notes" style="height: 100px" required placeholder="Комментарий"></textarea>
                        <label for="notes">Комментарий для клиента (результат диагностики) <span class="text-danger">*</span></label>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0 py-3 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">Отправить запрос</button>
                </div>
            </form>
        </div>
    </div>

    @if (canManageParts)
    {
        <div class="modal fade" id="addPartModal" tabindex="-1" aria-labelledby="addPartModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <form asp-action="AddOrderPart" method="post" class="modal-content border-0 shadow rounded-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    <div class="modal-header bg-info bg-opacity-10 border-info border-opacity-25 py-3 px-4">
                        <h5 class="modal-title fw-bold text-dark" id="addPartModalLabel">
                            <i class="fas fa-microchip text-info me-2"></i> Списать запчасть со склада
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-4">
                            Запчасть будет списана со склада и зафиксирована в заказе. Цена сохраняется на момент списания.
                        </p>
                        @if (availableParts.Any())
                        {
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label for="partId" class="form-label fw-medium">Запчасть</label>
                                    <select class="form-select rounded-3" id="partId" name="partId" required>
                                        <option value="">— Выберите запчасть —</option>
                                        @foreach (var part in availableParts)
                                        {
                                            var stockClass = part.QuantityInStock == 0 ? " (нет на складе)" : $" ({part.QuantityInStock} шт.)";
                                            <option value="@part.PartId"
                                                    data-stock="@part.QuantityInStock"
                                                    data-price="@part.UnitPrice"
                                                    disabled="@(part.QuantityInStock == 0 ? "disabled" : null)">
                                                @part.PartName@stockClass — @part.UnitPrice.ToString("C0")
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="quantity" class="form-label fw-medium">Количество</label>
                                    <input type="number" class="form-control rounded-3" id="quantity" name="quantity" min="1" value="1" required />
                                    <div class="form-text" id="partStockHint"></div>
                                </div>
                            </div>
                            <div class="mt-3 p-3 bg-light rounded-3 d-none" id="partPricePreview">
                                <span class="text-muted small">Сумма списания:</span>
                                <strong class="ms-2" id="partPriceTotal">0 ₽</strong>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0 rounded-3">
                                <i class="fas fa-warehouse me-2"></i>
                                На складе нет активных запчастей. <a asp-controller="Inventory" asp-action="Index">Перейти на склад</a>
                            </div>
                        }
                    </div>
                    <div class="modal-footer bg-light border-top-0 py-3 px-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Отмена</button>
                        @if (availableParts.Any())
                        {
                            <button type="submit" class="btn btn-info rounded-pill px-4 fw-bold shadow-sm text-white">
                                <i class="fas fa-check me-1"></i> Списать
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (canManageParts && availableParts.Any())
    {
        <script>
            (function () {
                const partSelect = document.getElementById('partId');
                const quantityInput = document.getElementById('quantity');
                const stockHint = document.getElementById('partStockHint');
                const preview = document.getElementById('partPricePreview');
                const totalEl = document.getElementById('partPriceTotal');

                function updatePreview() {
                    const option = partSelect.selectedOptions[0];
                    if (!option || !option.value) {
                        stockHint.textContent = '';
                        preview.classList.add('d-none');
                        return;
                    }
                    const stock = parseInt(option.dataset.stock, 10);
                    const price = parseFloat(option.dataset.price);
                    const qty = parseInt(quantityInput.value, 10) || 1;
                    stockHint.textContent = 'На складе: ' + stock + ' шт.';
                    stockHint.className = 'form-text ' + (qty > stock ? 'text-danger fw-bold' : 'text-muted');
                    totalEl.textContent = (price * qty).toLocaleString('ru-RU', { style: 'currency', currency: 'RUB', maximumFractionDigits: 0 });
                    preview.classList.remove('d-none');
                    quantityInput.max = stock;
                }

                partSelect?.addEventListener('change', updatePreview);
                quantityInput?.addEventListener('input', updatePreview);
            })();
        </script>
    }
}
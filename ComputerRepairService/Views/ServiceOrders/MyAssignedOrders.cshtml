@model IEnumerable<ComputerRepairService.Models.Entities.ServiceOrder>
@using ComputerRepairService.Services

@{
    ViewData["Title"] = "Мои задачи";

    var orders = Model
        .OrderByDescending(o => o.Priority)
        .ThenByDescending(o => o.CreatedDate)
        .ToList();

    var activeStatuses = new[] { "Новая", "Диагностика", "Ожидание запчастей", "В ремонте" };

    var totalOrders = orders.Count;
    var activeOrdersList = orders.Where(o => o.StatusId != ComputerRepairService.Models.Enums.OrderStatusIds.Issued && o.StatusId != ComputerRepairService.Models.Enums.OrderStatusIds.Cancelled).ToList();
    var completedOrdersList = orders.Where(o => o.StatusId == ComputerRepairService.Models.Enums.OrderStatusIds.Issued || o.StatusId == ComputerRepairService.Models.Enums.OrderStatusIds.Cancelled).ToList();

    var activeOrdersCount = activeOrdersList.Count;
    var diagnosticOrders = orders.Count(o => (o.OrderStatus?.StatusName ?? string.Empty) == "Диагностика");
    var highPriorityOrders = activeOrdersList.Count(o => o.Priority >= 3);

    string GetPriorityText(int priority) => priority switch
    {
        <= 0 => "Не указан",
        1 => "Низкий",
        2 => "Средний",
        3 => "Высокий",
        4 => "Срочный",
        _ => "Критичный"
    };

    string GetPriorityClass(int priority) => priority switch
    {
        <= 0 => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25",
        1 => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
        2 => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
        3 => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-50",
        4 => "bg-orange bg-opacity-10 text-orange border border-orange border-opacity-50",
        _ => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25"
    };
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-tasks"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Мои задачи</h2>
                <div class="text-muted small">Список назначенных на вас заказов на ремонт</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-list me-2"></i>Все заказы
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> <span class="text-success fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle text-danger me-2"></i> <span class="text-danger fw-medium">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-list-ol fs-5"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@totalOrders</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Всего задач</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-wrench fs-5 text-dark"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@activeOrdersCount</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Активные</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-stethoscope fs-5"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@diagnosticOrders</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">На диагностике</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="fas fa-exclamation-triangle fs-5"></i>
                        </div>
                    </div>
                    <h2 class="display-6 fw-bold mb-1 text-dark">@highPriorityOrders</h2>
                    <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Высокий приоритет</p>
                </div>
            </div>
        </div>
    </div>

    @if (!orders.Any())
    {
        <div class="text-center py-5 text-muted">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background-color: var(--bg-color);">
                <i class="fas fa-clipboard-check fa-2x opacity-50"></i>
            </div>
            <h5 class="fw-bold text-dark">У вас нет назначенных задач</h5>
            <p class="mb-4">Проверьте общий список заказов или дождитесь новых назначений.</p>
            <a asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-list me-2"></i> Перейти к списку заказов
            </a>
        </div>
    }
    else
    {
    <ul class="nav nav-tabs mb-4 border-bottom-0 gap-2" id="ordersTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-medium" id="active-tab" data-bs-toggle="tab" data-bs-target="#active-orders" type="button" role="tab" aria-controls="active-orders" aria-selected="true">
                <i class="fas fa-clock me-2"></i>Актуальные
                @if (activeOrdersList.Any())
                {
                    <span class="badge bg-primary rounded-pill ms-2">@activeOrdersList.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-medium" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed-orders" type="button" role="tab" aria-controls="completed-orders" aria-selected="false">
                <i class="fas fa-check-double me-2"></i>Завершенные
                <span class="badge bg-secondary rounded-pill ms-2">@completedOrdersList.Count</span>
            </button>
        </li>
    </ul>
    
    <div class="tab-content" id="ordersTabsContent">
            <!-- Вкладка: Актуальные заказы -->
            <div class="tab-pane fade show active" id="active-orders" role="tabpanel" aria-labelledby="active-tab">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 data-table w-100" id="activeOrdersTable">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-4 border-0">Заказ / Устройство</th>
                                        <th class="border-0">Клиент</th>
                                        <th class="border-0">Проблема</th>
                                        <th class="border-0">Статус</th>
                                        <th class="border-0">Приоритет</th>
                                        <th class="pe-4 border-0 text-end">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!activeOrdersList.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">Нет актуальных заказов</td>
                                        </tr>
                                    }
                                    @foreach (var order in activeOrdersList)
                                    {
                                        var statusName = order.OrderStatus?.StatusName ?? "Неизвестно";
                                        var problemText = order.ProblemDescription ?? string.Empty;
                                        var deviceType = order.DeviceType?.TypeName ?? "Не указан";
                                        var deviceLabel = string.Join(" ", new[] { order.DeviceBrand, order.DeviceModel }.Where(v => !string.IsNullOrWhiteSpace(v)));
                                        var customerName = order.Customer != null ? $"{order.Customer.FirstName} {order.Customer.LastName}".Trim() : "Не указан";

                                        <tr>
                                            <td class="ps-4 border-bottom-0">
                                                <div class="fw-bold text-dark">#@order.OrderId</div>
                                                <div class="small text-muted text-truncate" style="max-width: 150px;" title="@deviceType: @deviceLabel">
                                                    @deviceType: @deviceLabel
                                                </div>
                                            </td>
                                            <td class="border-bottom-0">
                                                <div class="fw-medium text-dark">@customerName</div>
                                                @if (!string.IsNullOrWhiteSpace(order.Customer?.Phone))
                                                {
                                                    <div class="small text-muted"><i class="fas fa-phone-alt me-1"></i>@order.Customer.Phone</div>
                                                }
                                            </td>
                                            <td class="border-bottom-0">
                                                <div class="text-truncate small" style="max-width: 250px;" title="@problemText">
                                                    @problemText
                                                </div>
                                            </td>
                                            <td class="border-bottom-0">
                                                <partial name="_OrderStatusBadge" model="statusName" />
                                            </td>
                                            <td class="border-bottom-0">
                                                <span class="badge rounded-pill px-2 py-1 @GetPriorityClass(order.Priority)">@GetPriorityText(order.Priority)</span>
                                            </td>
                                            <td class="pe-4 border-bottom-0 text-end">
                                                <div class="btn-group shadow-sm rounded-pill">
                                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-light btn-sm text-info px-3" title="Детали">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (ComputerRepairService.Services.OrderPaymentHelper.CanIssueDevice(order))
                                                    {
                                                        <a asp-action="IssueOrder" asp-route-id="@order.OrderId" class="btn btn-primary btn-sm px-3 border-start" title="Выдать">
                                                            <i class="fas fa-box-open"></i>
                                                        </a>
                                                    }
                                                    else if (OrderPaymentHelper.CanEmployeeComplete(order))
                                                    {
                                                        <a asp-action="CompleteOrder" asp-route-id="@order.OrderId" class="btn btn-success btn-sm px-3 border-start" title="Завершить">
                                                            <i class="fas fa-check-double"></i>
                                                        </a>
                                                    }
                                                    <a asp-action="Edit" asp-route-id="@order.OrderId" class="btn btn-light btn-sm text-warning px-3 border-start" title="Редактировать">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Вкладка: Завершенные заказы -->
            <div class="tab-pane fade" id="completed-orders" role="tabpanel" aria-labelledby="completed-tab">
                <div class="card border-0 shadow-sm rounded-4 opacity-75">
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 data-table w-100" id="completedOrdersTable">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-4 border-0">Заказ</th>
                                        <th class="border-0">Устройство</th>
                                        <th class="border-0">Статус</th>
                                        <th class="border-0">Даты</th>
                                        <th class="pe-4 border-0 text-end">Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!completedOrdersList.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">Нет завершенных заказов</td>
                                        </tr>
                                    }
                                    @foreach (var order in completedOrdersList)
                                    {
                                        var statusName = order.OrderStatus?.StatusName ?? "Неизвестно";
                                        var deviceType = order.DeviceType?.TypeName ?? "Не указан";
                                        var customerName = order.Customer != null ? $"{order.Customer.FirstName} {order.Customer.LastName}".Trim() : "Не указан";

                                        <tr>
                                            <td class="ps-4 border-bottom-0">
                                                <div class="fw-bold text-dark">#@order.OrderId</div>
                                                <div class="small text-muted">@customerName</div>
                                            </td>
                                            <td class="border-bottom-0">
                                                <div class="fw-medium text-dark">@order.DeviceBrand @order.DeviceModel</div>
                                                <span class="badge border" style="background-color: var(--bg-color); color: var(--text-main);">@deviceType</span>
                                            </td>
                                            <td class="border-bottom-0">
                                                <partial name="_OrderStatusBadge" model="statusName" />
                                            </td>
                                            <td class="border-bottom-0">
                                                <div class="small text-muted">Созд: @order.CreatedDate.ToString("dd.MM.yy")</div>
                                                <div class="small text-dark fw-medium">Зав: @(order.ActualCompletionDate?.ToString("dd.MM.yy") ?? "—")</div>
                                            </td>
                                            <td class="pe-4 border-bottom-0 text-end">
                                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-light btn-sm text-info rounded-pill px-3 shadow-sm" title="Детали">
                                                    <i class="fas fa-eye me-1"></i> Детали
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Custom styles */
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('.data-table')) {
                $('.data-table').DataTable().destroy();
            }
            
            $('.data-table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ru.json'
                },
                responsive: true,
                pageLength: 25,
                order: [[ 0, "desc" ]],
                dom: "<'row mb-3'<'col-sm-12 col-md-6 d-flex align-items-center justify-content-start'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });

        setTimeout(function () {
            $('.alert').alert('close');
        }, 5000);
    </script>
}
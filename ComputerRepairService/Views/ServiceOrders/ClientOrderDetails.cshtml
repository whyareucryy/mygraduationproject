@model ComputerRepairService.Models.Entities.ServiceOrder
@using ComputerRepairService.Services

@{
    ViewData["Title"] = $"Заказ #{Model.OrderId}";
    var canPay = OrderPaymentHelper.CanClientPay(Model);
    var canApprove = OrderPaymentHelper.CanClientApprove(Model);
    var isFullyPaid = OrderPaymentHelper.IsFullyPaid(Model);
    var amountDue = OrderPaymentHelper.GetAmountDue(Model);
    var paidAmount = OrderPaymentHelper.GetPaidAmount(Model);
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-file-alt"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Заказ #@Model.OrderId</h2>
                <div class="text-muted small">
                    От @Model.CreatedDate.ToString("dd.MM.yyyy") • 
                    <span class="badge bg-secondary ms-1">@Model.OrderStatus?.StatusName</span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
            @if (Model.OrderStatus?.StatusName == "Новая" || Model.OrderStatus?.StatusName == "Диагностика")
            {
                <button type="button" class="btn btn-outline-danger rounded-pill px-4 shadow-sm fw-medium" data-bs-toggle="modal" data-bs-target="#cancelModal">
                    <i class="fas fa-times-circle me-2"></i>Отменить
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle text-danger me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (canApprove)
    {
        <div class="alert alert-warning border-warning bg-warning bg-opacity-10 rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-2">
                <div>
                    <h5 class="alert-heading fw-bold mb-1"><i class="fas fa-exclamation-triangle text-warning me-2"></i>Требуется согласование</h5>
                    <p class="mb-0 text-dark">Мастер провел диагностику. Оценочная стоимость ремонта: <strong class="fs-5 ms-1">@Model.TotalCost.ToString("C0")</strong></p>
                </div>
                <form asp-action="ApproveOrder" asp-route-id="@Model.OrderId" method="post" class="mb-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
                        <i class="fas fa-check-circle me-2"></i> Согласовать ремонт
                    </button>
                </form>
            </div>
        </div>
    }
    else if (canPay)
    {
        <div class="alert alert-success border-success bg-success bg-opacity-10 rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-2">
                <div>
                    <h5 class="alert-heading fw-bold mb-1"><i class="fas fa-credit-card text-success me-2"></i>Ожидается оплата</h5>
                    <p class="mb-0 text-dark">Ремонт завершен или устройство готово к выдаче. К оплате: <strong class="fs-5 ms-1">@amountDue.ToString("C0")</strong></p>
                </div>
                <form asp-action="PayOrder" asp-route-id="@Model.OrderId" method="post" class="mb-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        <i class="fas fa-credit-card me-2"></i> Оплатить @amountDue.ToString("C0")
                    </button>
                </form>
            </div>
        </div>
    }
    else if (Model.OrderStatus?.StatusName == "Готово к выдаче")
    {
        <div class="alert alert-info border-info bg-info bg-opacity-10 rounded-4 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center p-2">
                <i class="fas fa-box text-info fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading fw-bold mb-0">Заказ готов к выдаче</h5>
                    <p class="mb-0 text-dark small">Вы можете забрать ваше устройство в нашем сервисном центре.</p>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100 mb-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-info-circle text-primary me-2"></i> Информация о заказе</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-calendar-alt"></i></div>
                                <div>
                                    <div class="text-muted small">Дата создания</div>
                                    <div class="fw-bold">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-exclamation-circle"></i></div>
                                <div>
                                    <div class="text-muted small">Приоритет</div>
                                    @{
                                        var priorityText = Model.Priority switch
                                        {
                                            1 => "Низкий", 2 => "Средний", 3 => "Высокий", 4 => "Срочный", 5 => "Критичный", _ => "Не указан"
                                        };
                                        var badgeColor = Model.Priority >= 4 ? "danger" : (Model.Priority == 3 ? "warning text-dark" : "info");
                                    }
                                    <span class="badge bg-@badgeColor">@priorityText</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-laptop"></i></div>
                                <div>
                                    <div class="text-muted small">Устройство</div>
                                    <div class="fw-bold">@Model.DeviceBrand @Model.DeviceModel <span class="badge bg-secondary ms-1">@Model.DeviceType?.TypeName</span></div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary"><i class="fas fa-barcode"></i></div>
                                <div>
                                    <div class="text-muted small">Серийный номер</div>
                                    <div class="fw-bold">@(Model.SerialNumber ?? "Не указан")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-dark"><i class="fas fa-comment-dots text-secondary me-2"></i>Ваша жалоба (описание проблемы)</h6>
                        <div class="p-3 bg-light rounded-3 border-start border-4 border-danger">
                            @Model.ProblemDescription
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DiagnosticNotes))
                    {
                        <div class="mb-0">
                            <h6 class="fw-bold text-dark"><i class="fas fa-stethoscope text-info me-2"></i>Результат диагностики</h6>
                            <div class="p-3 bg-info bg-opacity-10 rounded-3 border-start border-4 border-info">
                                @Model.DiagnosticNotes
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Model.OrderStatusHistories != null && Model.OrderStatusHistories.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history text-secondary me-2"></i> История статусов</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="timeline ps-2">
                            @foreach (var history in Model.OrderStatusHistories.OrderByDescending(h => h.ChangedDate))
                            {
                                <div class="timeline-item position-relative mb-4 pb-2 border-start border-2 border-light ps-4">
                                    <div class="timeline-marker position-absolute bg-primary rounded-circle shadow-sm" style="width: 16px; height: 16px; left: -9px; top: 0;"></div>
                                    <div class="timeline-content">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold text-dark mb-0">@history.OrderStatus?.StatusName</h6>
                                            <small class="text-muted bg-light rounded-pill px-2 py-1">@history.ChangedDate.ToString("dd.MM.yy HH:mm")</small>
                                        </div>
                                        @if (!string.IsNullOrEmpty(history.Notes))
                                        {
                                            <p class="mb-1 text-muted small">@history.Notes</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-gradient text-white position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fas fa-wallet fa-4x"></i>
                </div>
                <div class="card-body p-4 text-center position-relative">
                    <h6 class="fw-bold mb-3 opacity-75 text-uppercase" style="letter-spacing: 1px;">Итоговая стоимость</h6>
                    <h1 class="display-4 fw-bold mb-3">@Model.TotalCost.ToString("C0")</h1>
                    
                    @if (paidAmount > 0)
                    {
                        <div class="bg-white bg-opacity-25 rounded-pill px-3 py-2 mb-2 d-inline-block">
                            Оплачено: <strong>@paidAmount.ToString("C0")</strong>
                        </div>
                    }
                    @if (canPay)
                    {
                        <div class="bg-danger bg-opacity-25 rounded-pill px-3 py-2 mb-2 d-inline-block">
                            Осталось: <strong>@amountDue.ToString("C0")</strong>
                        </div>
                    }
                    <div class="mt-3 opacity-75 small">
                        @if (Model.ActualCompletionDate.HasValue)
                        {
                            <span><i class="fas fa-check-circle me-1"></i> Завершен: @Model.ActualCompletionDate.Value.ToString("dd.MM.yyyy")</span>
                        }
                        else if (Model.EstimatedCompletionDate.HasValue)
                        {
                            <span><i class="fas fa-clock me-1"></i> Ориентировочно до: @Model.EstimatedCompletionDate.Value.ToString("dd.MM.yyyy")</span>
                        }
                    </div>
                </div>
            </div>

            @if (Model.OrderServices != null && Model.OrderServices.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-concierge-bell text-warning me-2"></i> Выполненные работы</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush rounded-bottom-4">
                            @foreach (var service in Model.OrderServices)
                            {
                                <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-medium text-dark">@service.Service?.ServiceName</div>
                                    </div>
                                    <span class="fw-bold text-success">@service.TotalPrice.ToString("C0")</span>
                                </li>
                            }
                            <li class="list-group-item px-4 py-3 bg-light border-0 rounded-bottom-4 d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-muted text-uppercase small">Итого работы:</span>
                                <span class="fw-bold text-dark">@Model.OrderServices.Sum(s => s.TotalPrice).ToString("C0")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            @if (Model.OrderParts != null && Model.OrderParts.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-microchip text-info me-2"></i> Запчасти</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush rounded-bottom-4">
                            @foreach (var part in Model.OrderParts)
                            {
                                <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-medium text-dark">@part.Inventory?.PartName</div>
                                        <small class="text-muted">@part.QuantityUsed шт. × @part.UnitPriceAtTime.ToString("C0")</small>
                                    </div>
                                    <span class="fw-bold text-success">@part.TotalPrice.ToString("C0")</span>
                                </li>
                            }
                            <li class="list-group-item px-4 py-3 bg-light border-0 rounded-bottom-4 d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-muted text-uppercase small">Итого запчасти:</span>
                                <span class="fw-bold text-dark">@Model.OrderParts.Sum(p => p.TotalPrice).ToString("C0")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            @if (Model.Payments != null && Model.Payments.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-receipt text-success me-2"></i> История платежей</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush rounded-bottom-4">
                            @foreach (var payment in Model.Payments)
                            {
                                <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-medium text-dark">@payment.PaymentDate.ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted">
                                            @if(payment.PaymentMethod == "Cash") { <span>Наличные</span> }
                                            else if(payment.PaymentMethod == "Card") { <span>Карта</span> }
                                            else if(payment.PaymentMethod == "Online") { <span>Онлайн</span> }
                                            else { <span>@payment.PaymentMethod</span> }
                                            - 
                                            @if(payment.Status == "Completed") { <span class="text-success">Оплачен</span> }
                                            else if(payment.Status == "Pending") { <span class="text-warning">Ожидание</span> }
                                            else { <span>@payment.Status</span> }
                                        </small>
                                    </div>
                                    <span class="fw-bold @(payment.Status == "Completed" ? "text-success" : "text-muted")">@payment.Amount.ToString("C0")</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно отмены заказа -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-danger bg-opacity-10 border-danger border-opacity-25 py-3 px-4">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Отмена заказа</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                    <i class="fas fa-times fa-2x text-danger opacity-75"></i>
                </div>
                <h5 class="fw-bold mb-2">Вы уверены?</h5>
                <p class="text-muted mb-0">Вы собираетесь отменить заказ #@Model.OrderId.</p>
                <p class="text-danger small mt-2 fw-medium">Отмена заказа будет невозможна после того, как мастер начнет работу с устройством.</p>
            </div>
            <div class="modal-footer bg-light border-top-0 py-3 px-4 d-flex justify-content-center">
                <button type="button" class="btn btn-light rounded-pill px-4 border" data-bs-dismiss="modal">Закрыть</button>
                <form asp-action="CancelOrder" asp-route-id="@Model.OrderId" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">Да, отменить заказ</button>
                </form>
            </div>
        </div>
    </div>
</div>
@model ComputerRepairService.Models.ViewModels.CompleteOrderViewModel

@{
    ViewData["Title"] = $"Завершение заказа #{Model.OrderId}";
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="MyAssignedOrders">Мои задачи</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.OrderId">Заказ #@Model.OrderId</a></li>
            <li class="breadcrumb-item active">Завершение</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center mb-4">
        <div class="bg-success bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 56px; height: 56px;">
            <i class="fas fa-check-double fa-lg"></i>
        </div>
        <div>
            <h2 class="mb-0 fw-bold">Завершить ремонт</h2>
            <p class="text-muted mb-0 small">Заказ #@Model.OrderId перейдёт в статус «Готово к выдаче»</p>
        </div>
    </div>

    <div class="alert alert-info border-info bg-info bg-opacity-10 rounded-4 shadow-sm">
        <i class="fas fa-info-circle me-2"></i>
        Стоимость запчастей подставляется автоматически из списаний со склада. Укажите стоимость работ — итоговая сумма уйдёт клиенту на оплату.
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <form asp-action="CompleteOrder" asp-route-id="@Model.OrderId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OrderId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0">Параметры заказа</h5>
                    </div>
                    <div class="card-body p-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Клиент</dt>
                            <dd class="col-sm-8 fw-medium">@Model.CustomerName</dd>
                            <dt class="col-sm-4 text-muted">Устройство</dt>
                            <dd class="col-sm-8 fw-medium">@Model.DeviceDescription</dd>
                            <dt class="col-sm-4 text-muted">Статус</dt>
                            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.CurrentStatusName</span></dd>
                            <dt class="col-sm-4 text-muted">Проблема</dt>
                            <dd class="col-sm-8">@Model.ProblemDescription</dd>
                        </dl>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4 border-success border-opacity-25">
                    <div class="card-header bg-success bg-opacity-10 border-bottom border-success border-opacity-25 pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-success"><i class="fas fa-receipt me-2"></i> Смета для клиента</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted">Запчасти (из склада)</label>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-lg bg-light" readonly value="@Model.PartsTotal.ToString("N2")" />
                                    <span class="input-group-text">₽</span>
                                </div>
                                <div class="form-text">
                                    <a asp-action="Details" asp-route-id="@Model.OrderId">Изменить запчасти в карточке заказа</a>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LaborCost" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="LaborCost" class="form-control form-control-lg" type="number" step="0.01" min="0" id="laborCost" />
                                    <span class="input-group-text">₽</span>
                                </div>
                                <span asp-validation-for="LaborCost" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="p-4 bg-light rounded-4 d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-muted text-uppercase small">Итого к оплате</span>
                            <span class="display-6 fw-bold text-success mb-0" id="totalPreview">@Model.TotalCost.ToString("C0")</span>
                        </div>

                        <div class="mt-4">
                            <label asp-for="TechnicianNotes" class="form-label"></label>
                            <textarea asp-for="TechnicianNotes" class="form-control rounded-3" rows="4" placeholder="Что было сделано, рекомендации клиенту..."></textarea>
                            <span asp-validation-for="TechnicianNotes" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-4 shadow-sm">
                        <i class="fas fa-paper-plane me-2"></i> Завершить и отправить на оплату
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const partsTotal = @Model.PartsTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const laborInput = document.getElementById('laborCost');
            const totalEl = document.getElementById('totalPreview');

            function updateTotal() {
                const labor = parseFloat(laborInput.value) || 0;
                const total = partsTotal + labor;
                totalEl.textContent = total.toLocaleString('ru-RU', { style: 'currency', currency: 'RUB', maximumFractionDigits: 0 });
            }

            laborInput?.addEventListener('input', updateTotal);
        })();
    </script>
}

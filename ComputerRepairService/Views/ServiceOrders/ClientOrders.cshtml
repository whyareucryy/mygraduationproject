@model IEnumerable<ComputerRepairService.Models.Entities.ServiceOrder>
@using ComputerRepairService.Services

@{
    ViewData["Title"] = "Мои заказы";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Мои заказы</h2>
                <div class="text-muted small">Список ваших обращений в сервисный центр</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-plus-circle me-2"></i>Новый заказ
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> <span class="text-success fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle text-danger me-2"></i> <span class="text-danger fw-medium">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; background-color: var(--bg-color);">
                <i class="fas fa-inbox fa-2x opacity-50"></i>
            </div>
            <h5 class="fw-bold text-dark">У вас пока нет заказов</h5>
            <p class="mb-4">Создайте свой первый заказ на ремонт.</p>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fas fa-plus me-2"></i> Создать заказ
            </a>
        </div>
    }
    else
    {
        var activeOrdersList = Model.Where(o => o.StatusId != ComputerRepairService.Models.Enums.OrderStatusIds.Issued && o.StatusId != ComputerRepairService.Models.Enums.OrderStatusIds.Cancelled).ToList();
        var historyOrdersList = Model.Where(o => o.StatusId == ComputerRepairService.Models.Enums.OrderStatusIds.Issued || o.StatusId == ComputerRepairService.Models.Enums.OrderStatusIds.Cancelled).ToList();

        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4 position-relative text-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                            <i class="fas fa-list-ol fs-4"></i>
                        </div>
                        <h2 class="display-6 fw-bold mb-1 text-dark">@Model.Count()</h2>
                        <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Всего заказов</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4 position-relative text-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                            <i class="fas fa-tools fs-4 text-dark"></i>
                        </div>
                        <h2 class="display-6 fw-bold mb-1 text-dark">@Model.Count(o => o.OrderStatus?.StatusName == "В ремонте" || o.OrderStatus?.StatusName == "Диагностика")</h2>
                        <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">В работе</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4 position-relative text-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                            <i class="fas fa-box fs-4"></i>
                        </div>
                        <h2 class="display-6 fw-bold mb-1 text-dark">@Model.Count(o => o.OrderStatus?.StatusName == "Готово к выдаче")</h2>
                        <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Готовы к выдаче</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-primary bg-gradient text-white">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="fas fa-wallet fa-4x text-white"></i>
                    </div>
                    <div class="card-body p-4 position-relative text-center">
                        <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 56px; height: 56px;">
                            <i class="fas fa-ruble-sign fs-4 text-white"></i>
                        </div>
                        <h3 class="fw-bold mb-1 text-white">@Model.Where(o => o.TotalCost > 0).Sum(o => o.TotalCost).ToString("C0")</h3>
                        <p class="text-white-50 mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Сумма заказов</p>
                    </div>
                </div>
            </div>
        </div>

    <ul class="nav nav-tabs mb-4 border-bottom-0 gap-2" id="clientOrdersTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-medium" id="active-tab" data-bs-toggle="tab" data-bs-target="#active-orders" type="button" role="tab" aria-controls="active-orders" aria-selected="true">
                <i class="fas fa-clock me-2"></i>Актуальные
                @if (activeOrdersList.Any())
                {
                    <span class="badge bg-primary rounded-pill ms-2">@activeOrdersList.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-medium" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-orders" type="button" role="tab" aria-controls="history-orders" aria-selected="false">
                <i class="fas fa-history me-2"></i>История заказов
                <span class="badge bg-secondary rounded-pill ms-2">@historyOrdersList.Count</span>
            </button>
        </li>
    </ul>

        <div class="tab-content" id="clientOrdersTabsContent">
            <!-- Актуальные -->
            <div class="tab-pane fade show active" id="active-orders" role="tabpanel" aria-labelledby="active-tab">
                <div class="row g-4">
                    @if (!activeOrdersList.Any())
                    {
                        <div class="col-12">
                            <div class="text-center py-5 text-muted rounded-4" style="background-color: var(--bg-color);">
                                Нет актуальных заказов
                            </div>
                        </div>
                    }
                    @foreach (var order in activeOrdersList)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0 text-dark">Заказ #@order.OrderId</h5>
                                    <partial name="_OrderStatusBadge" model="order.OrderStatus?.StatusName" />
                                </div>
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle p-2 me-3 text-secondary" style="background-color: var(--bg-color);"><i class="fas fa-laptop"></i></div>
                                        <div>
                                            <div class="text-muted small">Устройство</div>
                                            <div class="fw-bold">@order.DeviceBrand @order.DeviceModel <span class="badge border ms-1" style="background-color: var(--bg-color); color: var(--text-main);">@(order.DeviceType?.TypeName ?? "")</span></div>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <div class="text-muted small mb-1">Проблема</div>
                                        <div class="p-3 rounded-3 small" style="background-color: var(--bg-color);">
                                            @(order.ProblemDescription.Length > 100 ? order.ProblemDescription.Substring(0, 100) + "..." : order.ProblemDescription)
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-4">
                                        <div class="col-6">
                                            <div class="text-muted small mb-1">Создан</div>
                                            <div class="fw-bold fs-6">@order.CreatedDate.ToString("dd.MM.yyyy")</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted small mb-1">Стоимость</div>
                                            <div class="fw-bold fs-6 @(order.TotalCost > 0 ? "text-success" : "")">@(order.TotalCost > 0 ? order.TotalCost.ToString("C0") : "Не рассчитана")</div>
                                        </div>
                                    </div>
                                    @if (order.OrderTechnicians != null && order.OrderTechnicians.Any())
                                    {
                                        <div class="mb-0 border-top pt-3">
                                            <div class="text-muted small mb-2">Назначенные мастера:</div>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var tech in order.OrderTechnicians)
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill">
                                                        @tech.Technician?.FirstName @tech.Technician?.LastName
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-transparent border-top p-3">
                                    <div class="d-grid gap-2">
                                        @if (OrderPaymentHelper.CanClientApprove(order))
                                        {
                                            <form asp-action="ApproveOrder" asp-route-id="@order.OrderId" method="post" class="m-0 d-grid">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-warning rounded-pill fw-bold shadow-sm">
                                                    <i class="fas fa-check-circle me-1"></i> Согласовать
                                                </button>
                                            </form>
                                        }
                                        else if (OrderPaymentHelper.CanClientPay(order))
                                        {
                                            <a asp-action="UnpaidOrders" class="btn btn-success rounded-pill fw-bold shadow-sm">
                                                <i class="fas fa-credit-card me-1"></i> Оплатить
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-primary rounded-pill fw-medium">
                                            <i class="fas fa-eye me-1"></i> Подробнее
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- История заказов -->
            <div class="tab-pane fade" id="history-orders" role="tabpanel" aria-labelledby="history-tab">
                <div class="row g-4">
                    @if (!historyOrdersList.Any())
                    {
                        <div class="col-12">
                            <div class="text-center py-5 text-muted rounded-4" style="background-color: var(--bg-color);">
                                История заказов пуста
                            </div>
                        </div>
                    }
                    @foreach (var order in historyOrdersList)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden opacity-75">
                                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0 text-muted">Заказ #@order.OrderId</h5>
                                    <partial name="_OrderStatusBadge" model="order.OrderStatus?.StatusName" />
                                </div>
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="rounded-circle p-2 me-3 text-secondary" style="background-color: var(--bg-color);"><i class="fas fa-laptop"></i></div>
                                        <div>
                                            <div class="text-muted small">Устройство</div>
                                            <div class="fw-bold text-muted">@order.DeviceBrand @order.DeviceModel <span class="badge border ms-1" style="background-color: var(--bg-color); color: var(--text-main);">@(order.DeviceType?.TypeName ?? "")</span></div>
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-0">
                                        <div class="col-6">
                                            <div class="text-muted small mb-1">Создан</div>
                                            <div class="fw-bold fs-6 text-muted">@order.CreatedDate.ToString("dd.MM.yyyy")</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-muted small mb-1">Итого</div>
                                            <div class="fw-bold fs-6 text-muted">@(order.TotalCost > 0 ? order.TotalCost.ToString("C0") : "—")</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-top p-3">
                                    <div class="d-grid">
                                        <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-light rounded-pill border fw-medium shadow-sm">
                                            <i class="fas fa-eye me-1"></i> Детали
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Custom styles */
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        });
    </script>
}
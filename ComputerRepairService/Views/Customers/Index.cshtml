@model IEnumerable<ComputerRepairService.Models.Entities.Customer>

@{
    ViewData["Title"] = "Клиенты";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-info bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">База клиентов</h2>
                <div class="text-muted small">Управление пользователями и их контактами</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-info text-white rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-user-plus me-2"></i>Добавить клиента
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> <span class="text-success fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 data-table w-100">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                            <th class="ps-4 border-0">Клиент</th>
                                            <th class="border-0">Email</th>
                                            <th class="border-0">Телефон</th>
                                            <th class="border-0">Регистрация</th>
                                            <th class="border-0">Статус</th>
                                            <th class="pe-4 border-0 text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td class="ps-4 border-bottom-0" data-order="@customer.FirstName @customer.LastName">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-light text-info rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div class="fw-bold text-dark">@customer.FirstName @customer.LastName</div>
                                        </div>
                                    </td>
                                    <td class="border-bottom-0" data-order="@customer.Email">@(string.IsNullOrEmpty(customer.Email) ? "—" : customer.Email)</td>
                                    <td class="border-bottom-0" data-order="@customer.Phone"><span class="fw-medium">@customer.Phone</span></td>
                                    <td class="border-bottom-0 text-muted" data-order="@customer.RegistrationDate.Ticks">@customer.RegistrationDate.ToString("dd.MM.yyyy")</td>
                                    <td class="border-bottom-0" data-order="@customer.IsActive">
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1">Неактивен</span>
                                        }
                                    </td>
                                    <td class="pe-4 border-bottom-0 text-end">
                                        <div class="btn-group shadow-sm rounded-pill">
                                            <a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn btn-light btn-sm text-info px-3" title="Детали">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-light btn-sm text-warning px-3 border-start" title="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@customer.CustomerId" class="btn btn-light btn-sm text-danger px-3 border-start" title="Удалить">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-users fa-2x opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Клиентов пока нет</h5>
                    <p class="mb-4">База клиентов пуста. Начните с добавления первого клиента.</p>
                    <a asp-action="Create" class="btn btn-info text-white rounded-pill px-4 shadow-sm">
                        <i class="fas fa-user-plus me-2"></i> Добавить клиента
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
}
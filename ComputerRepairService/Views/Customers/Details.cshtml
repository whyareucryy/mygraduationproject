@model ComputerRepairService.Models.Entities.Customer

@{
    ViewData["Title"] = "Детали клиента";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-info bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-user"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">@Model.FirstName @Model.LastName</h2>
                <div class="text-muted small">
                    Регистрация: @Model.RegistrationDate.ToString("dd.MM.yyyy") • 
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success ms-1">Активен</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">Неактивен</span>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-warning rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-edit me-2"></i>Редактировать
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-address-card text-info me-2"></i> Контактные данные</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 h-100 d-flex align-items-center">
                                <div class="bg-white text-info rounded-circle p-3 me-3 shadow-sm"><i class="fas fa-phone fs-5"></i></div>
                                <div>
                                    <div class="text-muted small">Телефон</div>
                                    <div class="fw-bold fs-6">@Model.Phone</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 h-100 d-flex align-items-center">
                                <div class="bg-white text-primary rounded-circle p-3 me-3 shadow-sm"><i class="fas fa-envelope fs-5"></i></div>
                                <div>
                                    <div class="text-muted small">Email</div>
                                    <div class="fw-bold fs-6">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                                <div class="bg-white text-secondary rounded-circle p-3 me-3 shadow-sm"><i class="fas fa-map-marker-alt fs-5"></i></div>
                                <div>
                                    <div class="text-muted small">Адрес</div>
                                    <div class="fw-bold fs-6">@(string.IsNullOrEmpty(Model.Address) ? "Не указан" : Model.Address)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-gradient text-white position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fas fa-chart-line fa-4x"></i>
                </div>
                <div class="card-body p-4 position-relative">
                    <h6 class="fw-bold mb-3 opacity-75 text-uppercase" style="letter-spacing: 1px;">Всего заказов</h6>
                    <h1 class="display-5 fw-bold mb-0">@(Model.ServiceOrders?.Count ?? 0)</h1>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-history text-secondary me-2"></i>Последние заказы</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.ServiceOrders != null && Model.ServiceOrders.Any())
                    {
                        <ul class="list-group list-group-flush rounded-bottom-4">
                            @foreach (var order in Model.ServiceOrders.OrderByDescending(o => o.CreatedDate).Take(3))
                            {
                                <li class="list-group-item px-4 py-3 border-0 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <a asp-controller="ServiceOrders" asp-action="Details" asp-route-id="@order.OrderId" class="fw-bold text-decoration-none text-primary">Заказ #@order.OrderId</a>
                                        <span class="badge bg-secondary">@order.OrderStatus?.StatusName</span>
                                    </div>
                                    <div class="small text-muted text-truncate">@order.ProblemDescription</div>
                                    <div class="small text-muted mt-1"><i class="far fa-calendar-alt me-1"></i> @order.CreatedDate.ToString("dd.MM.yyyy")</div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-clipboard-list fa-2x mb-2 opacity-50"></i>
                            <p class="mb-0 small">Заказов пока нет</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
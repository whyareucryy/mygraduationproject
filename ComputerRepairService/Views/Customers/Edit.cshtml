@model ComputerRepairService.Models.Entities.Customer

@{
    ViewData["Title"] = "Редактировать клиента";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-info bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-user-edit"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Клиент: @Model.FirstName @Model.LastName</h2>
                <div class="text-muted small">Обновление контактной информации</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger border-danger border-opacity-25 bg-danger bg-opacity-10 rounded-3 mb-4 shadow-sm">
                            <h5 class="alert-heading text-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Ошибки валидации:</h5>
                            <ul class="mb-0 text-danger">
                                @foreach (var key in ViewData.ModelState.Keys)
                                {
                                    foreach (var error in ViewData.ModelState[key]!.Errors)
                                    {
                                        <li><strong>@key:</strong> @error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" asp-for="RegistrationDate" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control rounded-3" placeholder="Имя" />
                                    <label asp-for="FirstName">Имя <span class="text-danger">*</span></label>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control rounded-3" placeholder="Фамилия" />
                                    <label asp-for="LastName">Фамилия <span class="text-danger">*</span></label>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="Email" />
                            <label asp-for="Email">Email <span class="text-danger">*</span></label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Phone" class="form-control rounded-3" placeholder="Телефон" />
                            <label asp-for="Phone">Телефон <span class="text-danger">*</span></label>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Address" class="form-control rounded-3" rows="3" style="height: 100px" placeholder="Адрес"></textarea>
                            <label asp-for="Address">Адрес</label>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="form-check form-switch mb-4 p-3 bg-light rounded-3 d-flex align-items-center">
                            <input class="form-check-input fs-4 mt-0 mb-0 me-3" type="checkbox" role="switch" asp-for="IsActive" id="IsActiveSwitch">
                            <label class="form-check-label fw-bold text-dark m-0" for="IsActiveSwitch" style="padding-top: 2px;">Активный клиент (разрешен вход в систему)</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> Сохранить
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
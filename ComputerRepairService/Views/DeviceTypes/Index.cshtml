@model IEnumerable<ComputerRepairService.Models.Entities.DeviceType>

@{
    ViewData["Title"] = "Типы устройств";
    Layout = "_Layout";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-secondary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-laptop"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Справочник типов устройств</h2>
                <div class="text-muted small">Категории принимаемой в ремонт техники</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-plus me-2"></i>Добавить тип
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 data-table w-100">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 border-0" style="width: 80px;">ID</th>
                                <th class="border-0">Название типа</th>
                                <th class="border-0">Описание</th>
                                <th class="pe-4 border-0 text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 border-bottom-0 text-muted font-monospace">#@item.DeviceTypeId</td>
                                    <td class="border-bottom-0 fw-bold text-dark">@item.TypeName</td>
                                    <td class="border-bottom-0 text-muted small">@(item.Description ?? "—")</td>
                                    <td class="pe-4 border-bottom-0 text-end">
                                        <div class="btn-group shadow-sm rounded-pill">
                                            <a asp-action="Details" asp-route-id="@item.DeviceTypeId" class="btn btn-light btn-sm text-info px-3" title="Подробнее">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.DeviceTypeId" class="btn btn-light btn-sm text-warning px-3 border-start" title="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.DeviceTypeId" class="btn btn-light btn-sm text-danger px-3 border-start" title="Удалить">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-laptop fa-2x opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Справочник пуст</h5>
                    <p class="mb-4">Нет типов устройств. Начните с добавления новой категории.</p>
                    <a asp-action="Create" class="btn btn-secondary rounded-pill px-4 shadow-sm">
                        <i class="fas fa-plus me-2"></i> Добавить тип
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('.data-table')) {
                $('.data-table').DataTable().destroy();
            }
            
            $('.data-table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ru.json'
                },
                responsive: true,
                pageLength: 25,
                order: [[ 0, "asc" ]],
                dom: "<'row mb-3'<'col-sm-12 col-md-6 d-flex align-items-center justify-content-start'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}
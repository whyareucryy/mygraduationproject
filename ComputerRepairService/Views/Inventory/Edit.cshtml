@model ComputerRepairService.Models.Entities.Inventory

@{
    ViewData["Title"] = "Редактировать позицию склада";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-box"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Склад: @Model.PartName</h2>
                <div class="text-muted small">Управление остатками и ценой</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" asp-route-id="@Model.PartId" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="PartId" />
                        <input type="hidden" asp-for="IsActive" />

                        <h5 class="fw-bold mb-4 text-primary border-bottom pb-2">Параметры товара</h5>
                        
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="PartName" class="form-control rounded-3" placeholder="Название запчасти" />
                                    <label asp-for="PartName">Название запчасти <span class="text-danger">*</span></label>
                                    <span asp-validation-for="PartName" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CategoryId" class="form-select rounded-3" asp-items="ViewBag.CategoryId"></select>
                                    <label asp-for="CategoryId">Категория</label>
                                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <textarea asp-for="Description" class="form-control rounded-3" style="height: 100px" placeholder="Описание"></textarea>
                            <label asp-for="Description">Описание и характеристики</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-5">
                            <input asp-for="SupplierInfo" class="form-control rounded-3" placeholder="Поставщик" />
                            <label asp-for="SupplierInfo">Информация о поставщике</label>
                            <span asp-validation-for="SupplierInfo" class="text-danger small"></span>
                        </div>

                        <h5 class="fw-bold mb-4 text-success border-bottom pb-2">Остатки и цена</h5>

                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="QuantityInStock" class="form-control rounded-3 fs-5 fw-bold" min="0" placeholder="В наличии" />
                                    <label asp-for="QuantityInStock">В наличии (шт)</label>
                                    <span asp-validation-for="QuantityInStock" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="ReorderLevel" class="form-control rounded-3 text-warning fw-bold" min="0" placeholder="Порог оповещения" />
                                    <label asp-for="ReorderLevel">Порог оповещения (шт)</label>
                                    <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="UnitPrice" class="form-control rounded-3 fs-5 fw-bold text-success border-success" min="0" step="0.01" placeholder="Розничная цена" />
                                    <label asp-for="UnitPrice">Розничная цена (₽)</label>
                                    <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
                                <i class="fas fa-save me-2"></i> Сохранить позицию
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
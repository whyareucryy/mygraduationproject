@model IEnumerable<ComputerRepairService.Models.Entities.Inventory>

@{
    ViewData["Title"] = "Склад запчастей";

    var items = Model.OrderBy(i => i.PartName).ToList();
    var lowStockCount = items.Count(i => i.QuantityInStock <= i.ReorderLevel);
    var inStockCount = items.Count(i => i.QuantityInStock > i.ReorderLevel * 2);
    var mediumStockCount = items.Count(i => i.QuantityInStock > i.ReorderLevel && i.QuantityInStock <= i.ReorderLevel * 2);
    var totalValue = items.Sum(i => i.QuantityInStock * i.UnitPrice);
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-secondary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-boxes"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Склад запчастей</h2>
                <div class="text-muted small">Инвентаризация и управление остатками (Общая сумма: @totalValue.ToString("C0"))</div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="LowStock" class="btn btn-outline-danger rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-exclamation-triangle me-2"></i>Низкий запас (@lowStockCount)
            </a>
            <a asp-action="Create" class="btn btn-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-plus me-2"></i>Добавить позицию
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> <span class="text-success fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @if (items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 data-table w-100">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 border-0">Артикул / Название</th>
                                <th class="border-0">Категория</th>
                                <th class="border-0">Остаток</th>
                                <th class="border-0">Цена за ед.</th>
                                <th class="border-0">Поставщик</th>
                                <th class="pe-4 border-0 text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                var stockStatus = item.QuantityInStock <= item.ReorderLevel ? "danger" : (item.QuantityInStock <= item.ReorderLevel * 2 ? "warning" : "success");
                                <tr>
                                    <td class="ps-4 border-bottom-0">
                                        <div class="fw-bold text-dark">@item.PartName</div>
                                        <div class="small text-muted font-monospace">#@item.PartId</div>
                                    </td>
                                    <td class="border-bottom-0">@(item.PartCategory?.CategoryName ?? "—")</td>
                                    <td class="border-bottom-0">
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-@stockStatus bg-opacity-10 text-@stockStatus border border-@stockStatus border-opacity-25 rounded-pill px-2 py-1 fs-6 me-2">@item.QuantityInStock</span>
                                            @if(stockStatus == "danger") { <i class="fas fa-exclamation-circle text-danger" title="Ниже порога (@item.ReorderLevel)"></i> }
                                        </div>
                                    </td>
                                    <td class="border-bottom-0 fw-medium">@item.UnitPrice.ToString("C0")</td>
                                    <td class="border-bottom-0 small">@(string.IsNullOrWhiteSpace(item.SupplierInfo) ? "—" : item.SupplierInfo)</td>
                                    <td class="pe-4 border-bottom-0 text-end">
                                        <div class="btn-group shadow-sm rounded-pill">
                                            <a asp-action="Restock" asp-route-id="@item.PartId" class="btn btn-light btn-sm text-success px-3" title="Пополнить">
                                                <i class="fas fa-plus-circle"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.PartId" class="btn btn-light btn-sm text-info px-3 border-start" title="Детали">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.PartId" class="btn btn-light btn-sm text-warning px-3 border-start" title="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.PartId" class="btn btn-light btn-sm text-danger px-3 border-start" title="Удалить">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-boxes fa-2x opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Склад пуст</h5>
                    <p class="mb-4">Склад запчастей пока пуст. Добавьте первую позицию.</p>
                    <a asp-action="Create" class="btn btn-secondary rounded-pill px-4 shadow-sm">
                        <i class="fas fa-plus me-2"></i> Добавить позицию
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('.data-table')) {
                $('.data-table').DataTable().destroy();
            }
            
            $('.data-table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ru.json'
                },
                responsive: true,
                pageLength: 25,
                order: [[ 0, "asc" ]],
                dom: "<'row mb-3'<'col-sm-12 col-md-6 d-flex align-items-center justify-content-start'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}
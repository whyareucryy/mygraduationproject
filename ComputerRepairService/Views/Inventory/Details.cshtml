@model ComputerRepairService.Models.Entities.Inventory

@{
    ViewData["Title"] = "Детали позиции склада";
    var usageCount = Model.OrderParts?.Count ?? 0;
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-secondary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-box"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">@Model.PartName</h2>
                <div class="text-muted small">Артикул / ID: #@Model.PartId • Категория: @(Model.PartCategory?.CategoryName ?? "Не указана")</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Restock" asp-route-id="@Model.PartId" class="btn btn-success rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-plus-circle me-2"></i>Пополнить
            </a>
            <a asp-action="Edit" asp-route-id="@Model.PartId" class="btn btn-warning rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-edit me-2"></i>Изменить
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-info-circle text-primary me-2"></i> Основная информация</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h6 class="text-muted small mb-2">Описание</h6>
                        <div class="p-3 bg-light rounded-3">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "Нет описания" : Model.Description)
                        </div>
                    </div>
                    
                    <div class="mb-0">
                        <h6 class="text-muted small mb-2">Поставщик</h6>
                        <div class="p-3 bg-light rounded-3 d-flex align-items-center">
                            <i class="fas fa-truck text-secondary me-3 fs-5"></i>
                            <span class="fw-medium">@(string.IsNullOrWhiteSpace(Model.SupplierInfo) ? "Не указан" : Model.SupplierInfo)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 @(Model.QuantityInStock <= Model.ReorderLevel ? "bg-danger bg-gradient text-white" : "bg-success bg-gradient text-white") position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fas fa-cubes fa-4x"></i>
                </div>
                <div class="card-body p-4 position-relative">
                    <h6 class="fw-bold mb-3 opacity-75 text-uppercase" style="letter-spacing: 1px;">Остаток на складе</h6>
                    <h1 class="display-5 fw-bold mb-2">@Model.QuantityInStock <span class="fs-4 opacity-75">шт.</span></h1>
                    @if (Model.QuantityInStock <= Model.ReorderLevel)
                    {
                        <p class="mb-0 small"><i class="fas fa-exclamation-triangle me-1"></i> Критический остаток (мин. @Model.ReorderLevel)</p>
                    }
                    else
                    {
                        <p class="mb-0 small opacity-75"><i class="fas fa-check-circle me-1"></i> В норме (порог: @Model.ReorderLevel)</p>
                    }
                </div>
            </div>

            <div class="row g-4">
                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 text-center">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 48px; height: 48px;">
                                <i class="fas fa-tag text-success fs-5"></i>
                            </div>
                            <div class="text-muted small mb-1">Розничная цена</div>
                            <div class="fw-bold fs-5 text-dark">@Model.UnitPrice.ToString("C0")</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 text-center">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow-sm" style="width: 48px; height: 48px;">
                                <i class="fas fa-tools text-primary fs-5"></i>
                            </div>
                            <div class="text-muted small mb-1">Использовано в</div>
                            <div class="fw-bold fs-5 text-dark">@usageCount <span class="fs-6 text-muted fw-normal">заказах</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.OrderParts != null && Model.OrderParts.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mt-2">
            <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history text-secondary me-2"></i> История списаний</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Заказ</th>
                                <th>Кол-во</th>
                                <th>Цена</th>
                                <th>Сумма</th>
                                <th class="pe-4">Дата</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usage in Model.OrderParts.OrderByDescending(op => op.UsageDate).Take(20))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <a asp-controller="ServiceOrders" asp-action="Details" asp-route-id="@usage.OrderId" class="fw-medium text-decoration-none">
                                            #@usage.OrderId
                                        </a>
                                    </td>
                                    <td>@usage.QuantityUsed шт.</td>
                                    <td>@usage.UnitPriceAtTime.ToString("C0")</td>
                                    <td class="fw-bold text-success">@usage.TotalPrice.ToString("C0")</td>
                                    <td class="pe-4 text-muted small">@usage.UsageDate.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
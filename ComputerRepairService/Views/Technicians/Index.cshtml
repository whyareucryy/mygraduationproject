@model IEnumerable<ComputerRepairService.Models.Entities.Technician>

@{
    ViewData["Title"] = "Мастера";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-tools"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Штат мастеров</h2>
                <div class="text-muted small">Управление сотрудниками сервисного центра</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Workload" class="btn btn-outline-info rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-chart-bar me-2"></i>Нагрузка
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-plus me-2"></i>Добавить мастера
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> <span class="text-success fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 data-table w-100">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4 border-0">Мастер</th>
                                <th class="border-0">Контакты</th>
                                <th class="border-0">Специализация</th>
                                <th class="border-0">Ставка (час)</th>
                                <th class="border-0">Статус</th>
                                <th class="pe-4 border-0 text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tech in Model)
                            {
                                <tr>
                                    <td class="ps-4 border-bottom-0">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user-tie"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@tech.FirstName @tech.LastName</div>
                                                <div class="small text-muted">С @tech.HireDate.ToString("dd.MM.yyyy")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="border-bottom-0">
                                        <div class="small text-dark"><i class="fas fa-phone-alt text-muted me-1"></i>@(string.IsNullOrEmpty(tech.Phone) ? "—" : tech.Phone)</div>
                                        <div class="small text-dark"><i class="fas fa-envelope text-muted me-1"></i>@(string.IsNullOrEmpty(tech.Email) ? "—" : tech.Email)</div>
                                    </td>
                                    <td class="border-bottom-0">
                                        <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(tech.Specialization) ? "Общая" : tech.Specialization)</span>
                                    </td>
                                    <td class="border-bottom-0 fw-medium">
                                        @(tech.HourlyRate.HasValue ? tech.HourlyRate.Value.ToString("C0") : "—")
                                    </td>
                                    <td class="border-bottom-0">
                                        @if (tech.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1">Неактивен</span>
                                        }
                                    </td>
                                    <td class="pe-4 border-bottom-0 text-end">
                                        <div class="btn-group shadow-sm rounded-pill">
                                            <a asp-action="Details" asp-route-id="@tech.TechnicianId" class="btn btn-light btn-sm text-info px-3" title="Детали">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@tech.TechnicianId" class="btn btn-light btn-sm text-warning px-3 border-start" title="Редактировать">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@tech.TechnicianId" class="btn btn-light btn-sm text-danger px-3 border-start" title="Удалить">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="fas fa-users-cog fa-2x opacity-50"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Штат пуст</h5>
                    <p class="mb-4">В системе пока нет зарегистрированных мастеров.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="fas fa-plus me-2"></i> Добавить мастера
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('.data-table')) {
                $('.data-table').DataTable().destroy();
            }
            
            $('.data-table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/ru.json'
                },
                responsive: true,
                pageLength: 25,
                order: [[ 0, "asc" ]],
                dom: "<'row mb-3'<'col-sm-12 col-md-6 d-flex align-items-center justify-content-start'l><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row mt-3'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>"
            });
        });
    </script>
}
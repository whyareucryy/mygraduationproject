@{
    ViewData["Title"] = "Нагрузка мастеров";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 pb-3 border-bottom gap-3">
        <div class="d-flex align-items-center">
            <div class="bg-info bg-gradient text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="fas fa-chart-bar"></i>
            </div>
            <div>
                <h2 class="mb-1 fw-bold text-dark">Нагрузка мастеров</h2>
                <div class="text-muted small">Анализ занятости и эффективности сотрудников</div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm fw-medium">
                <i class="fas fa-arrow-left me-2"></i>Назад
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 rounded-4 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle text-success me-2"></i> <span class="text-success fw-medium">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.TechniciansWorkload != null && ((IEnumerable<dynamic>)ViewBag.TechniciansWorkload).Any())
    {
        var workloadList = (IEnumerable<dynamic>)ViewBag.TechniciansWorkload;
        
        <!-- Дополнительная статистика -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fas fa-users fs-5"></i>
                            </div>
                        </div>
                        <h2 class="display-6 fw-bold mb-1 text-dark">@workloadList.Count()</h2>
                        <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Всего мастеров</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fas fa-tools fs-5"></i>
                            </div>
                        </div>
                        @{
                            int totalActiveOrders = 0;
                            foreach (var item in workloadList)
                            {
                                totalActiveOrders += (int)item.ActiveOrders;
                            }
                        }
                        <h2 class="display-6 fw-bold mb-1 text-dark">@totalActiveOrders</h2>
                        <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Активных заказов</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                    <div class="card-body p-4 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fas fa-clock fs-5"></i>
                            </div>
                        </div>
                        @{
                            decimal allTotalHours = 0;
                            foreach (var item in workloadList)
                            {
                                allTotalHours += (decimal)item.TotalHours;
                            }
                        }
                        <h2 class="display-6 fw-bold mb-1 text-dark">@allTotalHours.ToString("F1")</h2>
                        <p class="text-muted mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Часов работы</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-info bg-gradient text-white">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="fas fa-chart-line fa-4x text-white"></i>
                    </div>
                    <div class="card-body p-4 position-relative">
                        <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 48px; height: 48px;">
                            <i class="fas fa-tachometer-alt fs-5 text-white"></i>
                        </div>
                        @{
                            double avgWorkload = workloadList.Count() > 0 ?
                            workloadList.Average(item => (int)item.ActiveOrders) : 0;
                        }
                        <h2 class="display-6 fw-bold mb-1">@avgWorkload.ToString("F1")</h2>
                        <p class="text-white-50 mb-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Средняя нагрузка</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Таблица -->
            <div class="col-xl-8">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-table text-primary me-2"></i> Детальная сводка</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 data-table w-100">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-4 border-0">Мастер</th>
                                        <th class="border-0">Заказы</th>
                                        <th class="border-0">Часы</th>
                                        <th class="border-0">Статус</th>
                                        <th class="pe-4 border-0 text-end">Прим. стоимость</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in workloadList)
                                    {
                                        var technician = item.Technician;
                                        var activeOrders = (int)item.ActiveOrders;
                                        var techTotalHours = (decimal)item.TotalHours;

                                        string workloadStatus;
                                        string statusClass;

                                        if (activeOrders <= 2)
                                        {
                                            workloadStatus = "Низкая";
                                            statusClass = "success";
                                        }
                                        else if (activeOrders <= 5)
                                        {
                                            workloadStatus = "Средняя";
                                            statusClass = "info";
                                        }
                                        else if (activeOrders <= 8)
                                        {
                                            workloadStatus = "Высокая";
                                            statusClass = "warning";
                                        }
                                        else
                                        {
                                            workloadStatus = "Очень высокая";
                                            statusClass = "danger";
                                        }

                                        decimal estimatedCost = 0;
                                        if (technician.HourlyRate != null && Convert.ToDecimal(technician.HourlyRate) > 0)
                                        {
                                            estimatedCost = techTotalHours * Convert.ToDecimal(technician.HourlyRate);
                                        }

                                        <tr>
                                            <td class="ps-4 border-bottom-0" data-order="@technician.FirstName @technician.LastName">
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-user-tie"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@technician.FirstName @technician.LastName</div>
                                                        <div class="small text-muted">@technician.Specialization</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="border-bottom-0" data-order="@activeOrders">
                                                <span class="badge bg-@statusClass bg-opacity-10 text-@statusClass border border-@statusClass border-opacity-25 rounded-pill px-2 py-1 fs-6">
                                                    @activeOrders
                                                </span>
                                            </td>
                                            <td class="border-bottom-0" data-order="@techTotalHours">
                                                <div class="fw-medium text-dark">@techTotalHours.ToString("F1") ч</div>
                                            </td>
                                            <td class="border-bottom-0" data-order="@activeOrders">
                                                <span class="badge bg-@statusClass bg-opacity-10 text-@statusClass border border-@statusClass border-opacity-25 rounded-pill">@workloadStatus</span>
                                            </td>
                                            <td class="pe-4 border-bottom-0 text-end" data-order="@estimatedCost">
                                                @if (estimatedCost > 0)
                                                {
                                                    <span class="fw-bold text-success">@estimatedCost.ToString("C0")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Визуализация нагрузки -->
            <div class="col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-transparent border-bottom pt-4 pb-3 px-4">
                        <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-tasks text-secondary me-2"></i> Визуализация</h5>
                    </div>
                    <div class="card-body p-4">
                        @foreach (var item in workloadList)
                        {
                            var technician = item.Technician;
                            var activeOrders = (int)item.ActiveOrders;
                            var maxOrders = 10;
                            var percentage = Math.Min((activeOrders / (double)maxOrders) * 100, 100);

                            string progressBarClass;
                            if (percentage < 30)
                            {
                                progressBarClass = "bg-success";
                            }
                            else if (percentage < 60)
                            {
                                progressBarClass = "bg-info";
                            }
                            else if (percentage < 80)
                            {
                                progressBarClass = "bg-warning";
                            }
                            else
                            {
                                progressBarClass = "bg-danger";
                            }

                            <div class="mb-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-medium text-dark small">@technician.FirstName @technician.LastName</span>
                                    <span class="fw-bold text-muted small">@activeOrders / @maxOrders</span>
                                </div>
                                <div class="progress rounded-pill shadow-sm" style="height: 12px; background-color: var(--bg-color);">
                                    <div class="progress-bar @progressBarClass rounded-pill"
                                         role="progressbar"
                                         style="width: @percentage%;"
                                         aria-valuenow="@activeOrders"
                                         aria-valuemin="0"
                                         aria-valuemax="@maxOrders">
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="fas fa-chart-bar fa-2x opacity-50"></i>
            </div>
            <h5 class="fw-bold text-dark">Нет данных о нагрузке</h5>
            <p class="mb-4">Данные о нагрузке мастеров появятся после назначения заказов.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="fas fa-users me-2"></i> К списку мастеров
                </a>
            }
        </div>
    }
</div>

@section Scripts {
}